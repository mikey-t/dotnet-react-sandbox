{
  "[javascript][typescript][csharp]": {
    "editor.autoIndent": "full",
    "editor.trimAutoWhitespace": false
  },
  "[javascript][typescript][typescriptreact][json][yaml]": {
    "editor.tabSize": 2
  },
  "[csharp]": {
    "editor.tabSize": 4,
  },
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.format.semicolons": "remove",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.preferences.importModuleSpecifier": "relative",
  "cSpell.words": [
    "appbar",
    "AWSSDK",
    "buildtransitive",
    "contentfiles",
    "coreclr",
    "Hmac",
    "nodb",
    "SYSLIB",
    "tanstack"
  ],
  "cSpell.ignorePaths": [
    "client/src/pages/Blog.tsx",
    "client/src/pages/Pricing.tsx",
    "client/src/pages/Products.tsx"
  ],
  "files.associations": {
    "*.sql": "postgres"
  }
}
